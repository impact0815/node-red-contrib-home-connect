{
  "name": "@impact0815/node-red-contrib-home-connect",
  "version": "0.2.0",
  "description": "Node-RED nodes for read-only local Home Connect WebSockets and the official cloud API with OAuth, rate-limit protection, health and guarded writes.",
  "keywords": [
    "node-red",
    "home-connect",
    "bosch",
    "siemens",
    "neff",
    "gaggenau",
    "appliance",
    "oauth2",
    "sse"
  ],
  "license": "MIT",
  "author": "impact0815",
  "homepage": "https://github.com/impact0815/node-red-contrib-home-connect#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/impact0815/node-red-contrib-home-connect.git"
  },
  "bugs": {
    "url": "https://github.com/impact0815/node-red-contrib-home-connect/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "nodes/home-connect.js",
  "homeConnectBuild": {
    "buildId": "hc-0.2.0-final",
    "oauthFlow": "authorization_code_client_secret",
    "pkce": false,
    "dashboardLocales": [
      "de",
      "en"
    ],
    "dashboardCompatibility": "@flowfuse/node-red-dashboard@1.34.1",
    "releaseStatus": "final",
    "featureFreeze": "2026-11-01",
    "isolatedDemo": "examples/demo-home-connect-flowfuse-1.34.1-scriptless.json"
  },
  "files": [
    "BUILD-INFO.json",
    "nodes",
    "lib",
    "examples",
    "docs",
    "README.md",
    "README.de.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18.0.0",
    "node-red": ">=3.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "node tools/lint.js",
    "validate": "npm run lint && npm test && npm pack --dry-run",
    "prepublishOnly": "npm run release:check && npm run validate",
    "release:check": "node tools/release-check.js"
  },
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "home-connect": "nodes/home-connect.js"
    }
  }
}
